<?xml version="1.0"?>
<ruleset name="Convertcart"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0
                             http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Convertcart code analysis rules</description>

    <!-- Basic rules with common exclusions for Magento 1 -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess" />
        <exclude name="ElseExpression" />
    </rule>
    
    <rule ref="rulesets/codesize.xml">
        <exclude name="ExcessiveClassComplexity" />
        <exclude name="ExcessiveMethodLength" />
        <exclude name="ExcessiveClassLength" />
        <exclude name="ExcessiveParameterList" />
        <exclude name="ExcessivePublicCount" />
        <exclude name="TooManyFields" />
        <exclude name="TooManyMethods" />
        <exclude name="TooManyPublicMethods" />
    </rule>
    
    <rule ref="rulesets/controversial.xml">
        <exclude name="CamelCaseClassName" />
        <exclude name="CamelCasePropertyName" />
        <exclude name="CamelCaseMethodName" />
        <exclude name="CamelCaseParameterName" />
        <exclude name="CamelCaseVariableName" />
        <exclude name="Superglobals" />
        <exclude name="LongClass" />
        <exclude name="TooManyFields" />
        <exclude name="TooManyMethods" />
        <exclude name="TooManyPublicMethods" />
        <exclude name="NumberOfChildren" />
        <exclude name="ExcessiveClassComplexity" />
    </rule>
    
    <rule ref="rulesets/design.xml">
        <exclude name="CouplingBetweenObjects" />
        <exclude name="DevelopmentCodeFragment" />
        <exclude name="EvalExpression" />
        <exclude name="ExitExpression" />
        <exclude name="LongClass" />
        <exclude name="TooManyFields" />
        <exclude name="TooManyMethods" />
        <exclude name="TooManyPublicMethods" />
        <exclude name="NumberOfChildren" />
    </rule>
    
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortMethodName" />
        <exclude name="ConstructorWithNameAsEnclosingClass" />
        <exclude name="LongVariable" />
        <exclude name="ShortVariable" />
        <exclude name="LongClassName" />
    </rule>
    
    <rule ref="rulesets/unusedcode.xml">
        <exclude name="UnusedFormalParameter" />
        <exclude name="UnusedPrivateField" />
        <exclude name="UnusedLocalVariable" />
        <exclude name="UnusedPrivateMethod" />
    </rule>
    
    <!-- Suppress common Magento 1 patterns -->
    <rule ref="rulesets/design.xml/ExcessiveClassComplexity">
        <properties>
            <property name="exceptions" value="Convertcart_Model_Analytics_Cc,Convertcart_Helper_Analytics_ViewTracking,Convertcart_Helper_Sync,Convertcart_Model_Analytics_Observer,Convertcart_Model_Sync_Cc" />
        </properties>
    </rule>
    
    <rule ref="rulesets/design.xml/TooManyMethods">
        <properties>
            <property name="exceptions" value="Convertcart_Model_Analytics_Observer" />
        </properties>
    </rule>
    
    <rule ref="rulesets/design.xml/TooManyPublicMethods">
        <properties>
            <property name="exceptions" value="Convertcart_Model_Analytics_Observer,Convertcart_Model_Sync_SyncController" />
        </properties>
    </rule>
    
    <rule ref="rulesets/cleancode.xml/ElseExpression">
        <properties>
            <property name="exceptions" value="Convertcart_Helper_Analytics,Convertcart_Helper_Sync,Convertcart_Model_Analytics_Cc,Convertcart_Model_Analytics_Observer,Convertcart_Model_Sync_Cc,Convertcart_Model_Sync_Observer,Convertcart_Model_Sync_Sync,Convertcart_Model_Sync_ActivityController" />
        </properties>
    </rule>
</ruleset>
