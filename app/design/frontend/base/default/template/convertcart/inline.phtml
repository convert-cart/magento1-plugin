<!-- ConvertCart Inline Script -->
<script type="text/javascript" data-cfasync="false">
//<![CDATA[
if (typeof window.ccart === 'undefined' && !window._ccScriptLoading) {
    window._ccScriptLoading = true;
    window.ccLayer = window.ccLayer || [];
    window.ccart = window.ccart || function() {
        (window.ccart.q = window.ccart.q || []).push(arguments);
    };
    
    // Load the script
    var script = document.createElement('script');
    script.type = 'text/javascript';
    script.async = true;
    script.src = '//cdn.convertcart.com/<?php echo $this->getClientKey(); ?>.js';
    
    script.onload = function() {
        window.ccart.loaded = true;
        // Process any queued events
        if (window.ccart.q) {
            while (window.ccart.q.length > 0) {
                var args = window.ccart.q.shift();
                window.ccart.apply(this, args);
            }
        }
        
        // Process any events in ccLayer
        if (window.ccLayer && window.ccLayer.length > 0) {
            while (window.ccLayer.length > 0) {
                var eventArgs = window.ccLayer.shift();
                if (Array.isArray(eventArgs) && eventArgs.length > 0 && window.ccart[eventArgs[0]]) {
                    window.ccart[eventArgs[0]].apply(window.ccart, eventArgs.slice(1));
                } else if (typeof eventArgs === 'function') {
                    eventArgs();
                }
            }
        }
    };
    
    script.onerror = function() {
        console.error('Failed to load ConvertCart tracking script');
        window._ccScriptLoading = false;
    };
    
    // Try to inject into head, fall back to document.body
    var head = document.getElementsByTagName('head')[0] || document.documentElement;
    head.insertBefore(script, head.firstChild);
}
//]]>
</script>
<!-- End ConvertCart Inline Script -->
