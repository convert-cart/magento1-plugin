<config>
    <tabs>
        <convertcart_config translate="label" module="convertcart">
            <label>ConvertCart</label>
            <sort_order>500</sort_order>
        </convertcart_config>
    </tabs>
    <sections>
        <convertcart translate="label" module="convertcart">
            <class>separator-top</class>
            <label>ConvertCart Configuration</label>
            <tab>convertcart_config</tab>
            <resource>convertcart/config</resource>
            <groups>
                <configuration translate="label">
                    <label>ConvertCart Configuration</label>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <domainid>
                            <label>Domain ID</label>
                            <comment><![CDATA[Your ConvertCart Domain ID. <a href="https://app.convertcart.com/settings/domains" target="_blank">Find your Domain ID</a>]]></comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <validate>required-entry</validate>
                        </domainid>
                        <api_key>
                            <label>API Key</label>
                            <comment><![CDATA[Your ConvertCart API key for data synchronization. <a href="https://app.convertcart.com/settings/developers" target="_blank">Generate API Key</a>]]></comment>
                            <frontend_type>text</frontend_type>
                            <frontend_model>convertcart/field_name_renderer</frontend_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </api_key>
                    </fields>
                </configuration>
            </groups>
        </convertcart>
    </sections>
</config>
