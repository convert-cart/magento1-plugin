<config>
    <tabs>
        <convertcart translate="label" module="convertcart">
            <label>Convert Cart</label>
            <sort_order>99999</sort_order>
        </convertcart>
    </tabs>
    <sections>
        <convertcart translate="label" module="convertcart">
            <label>Convert Cart Keys</label>
            <tab>convertcart</tab>
            <frontend_type>text</frontend_type>
            <sort_order>1000</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>1</show_in_store>
            <groups>
                <analytics_config translate="label">
                    <label>Analytics Keys</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>1</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <client_key>
                            <label>Enter Your Client Id / Domain Id</label>
                            <comment>Contact ConvertCart to get this key</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </client_key>
                        <script_domain>
                            <label>Enter Script Domain</label>
                            <comment>Default is cdn.convertcart/analytics_cc</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </script_domain>
                    </fields>
                </analytics_config>
                <sync_config translate="label">
                    <label>Sync Keys</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>2</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <api_key translate="label">
                            <label>API Key</label>
                            <comment>Please Send this key to ConvertCart</comment>
                            <frontend_type>text</frontend_type>
                            <frontend_model>Convertcart_Model_Sync_Block_Field_Name_Renderer</frontend_model>
                            <sort_order>6</sort_order>
                            <show_in_default>1</show_in_default>
                        </api_key>
                        <reset_api_key translate="label">
                            <label>Reset API Key</label>
                            <comment>To Reset key, Select 'Yes'->Save Config</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>28</sort_order>
                            <show_in_default>1</show_in_default>
                        </reset_api_key>
                    </fields>
                </sync_config>
            </groups>
        </convertcart>
    </sections>
</config>
