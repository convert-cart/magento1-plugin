<?xml version="1.0" encoding="UTF-8"?>
<config>
    <modules>
        <Convertcart>
            <version>1.5.0</version>
            <depends>
                <Mage_Core />
            </depends>
        </Convertcart>
    </modules>
    
    <!-- Global Configuration -->
    <default>
        <convertcart>
            <configuration>
                <enabled>1</enabled>
                <debug>0</debug>
                <enable_logging>0</enable_logging>
            </configuration>
        </convertcart>
    </default>
    
    <global>
        <helpers>
            <cc_analytics>
                <class>Convertcart_Helper_Analytics</class>
            </cc_analytics>
            <!-- Legacy alias for backward compatibility -->
            <convertcart_analytics>
                <class>Convertcart_Helper_Analytics</class>
            </convertcart_analytics>
        </helpers>
    </global>
    <frontend>
        <events>
            <!-- Analytics Observers -->
            <controller_action_layout_render_before>
                <observers>
                    <Convertcart_Model_Analytics>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>addBlock</method>
                    </Convertcart_Model_Analytics>
                    <convertcart_analytics_cc_init>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>ccInit</method>
                    </convertcart_analytics_cc_init>
                </observers>
            </controller_action_layout_render_before>
            
            <!-- Fallback script injection for custom themes -->
            <controller_action_layout_generate_xml_before>
                <observers>
                    <convertcart_analytics_fallback_script>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>addFallbackScript</method>
                    </convertcart_analytics_fallback_script>
                </observers>
            </controller_action_layout_generate_xml_before>
            <checkout_cart_product_add_after>
                <observers>
                    <convertcart_analytics_cc_add_to_cart>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>addToCart</method>
                    </convertcart_analytics_cc_add_to_cart>
                </observers>
            </checkout_cart_product_add_after>
            <controller_action_layout_generate_blocks_after>
                <observers>
                    <convertcart_analytics_cc_homepage_view>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>homepageView</method>
                    </convertcart_analytics_cc_homepage_view>
                    <convertcart_analytics_cc_cmsView>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>cmsView</method>
                    </convertcart_analytics_cc_cmsView>
                    <convertcart_analytics_cc_category_view>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>categoryView</method>
                    </convertcart_analytics_cc_category_view>
                    <convertcart_analytics_cc_product_view>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>productView</method>
                    </convertcart_analytics_cc_product_view>
                    <convertcart_analytics_cc_cart_view>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>cartView</method>
                    </convertcart_analytics_cc_cart_view>
                    <convertcart_analytics_cc_checkout_view>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>checkoutView</method>
                    </convertcart_analytics_cc_checkout_view>
                    <convertcart_analytics_cc_wishlist_view>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>wishlistView</method>
                    </convertcart_analytics_cc_wishlist_view>
                    <convertcart_analytics_cc_compare_view>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>compareView</method>
                    </convertcart_analytics_cc_compare_view>
                </observers>
            </controller_action_layout_generate_blocks_after>
            <catalogsearch_query_load_after>
                <observers>
                    <convertcart_analytics_cc_search_view>
                        <type>singleton</type>
                        <class>Convertcart_Model_Analytics_Observer</class>
                        <method>searchView</method>
                    </convertcart_analytics_cc_search_view>
                </observers>
            </catalogsearch_query_load_after>
            <!-- ... (other analytics events) ... -->
            <!-- Sync Routers -->
            <routers>
                <cc_sync>
                    <use>standard</use>
                    <args>
                        <module>Convertcart</module>
                        <frontName>convertcart</frontName>
                    </args>
                </cc_sync>
            </routers>
        </events>
    </frontend>
    <global>
        <helpers>
            <convertcart>
                <class>Convertcart_Helper</class>
            </convertcart>
        </helpers>
        <resources>
            <convertcart_setup>
                <setup>
                    <module>Convertcart</module>
                    <class>Mage_Core_Model_Resource_Setup</class>
                </setup>
                <connection>
                    <use>core_setup</use>
                </connection>
            </convertcart_setup>
            <convertcart_write>
                <connection>
                    <use>core_write</use>
                </connection>
            </convertcart_write>
            <convertcart_read>
                <connection>
                    <use>core_read</use>
                </connection>
            </convertcart_read>
        </resources>
        <models>
            <convertcart_analytics_cc>
                <class>Convertcart_Model_Analytics</class>
            </convertcart_analytics_cc>
            <convertcart_sync_cc>
                <class>Convertcart_Model_Sync</class>
                <resourceModel>convertcart_sync_cc_resource</resourceModel>
            </convertcart_sync_cc>
            <convertcart_sync_cc_resource>
                <class>Convertcart_Model_Sync_Resource</class>
                <entities>
                    <activity>
                        <table>convertcart_sync_cc_activity</table>
                    </activity>
                </entities>
            </convertcart_sync_cc_resource>
        </models>
        <resources>
            <convertcart_sync_cc_setup>
                <setup>
                    <module>Convertcart</module>
                </setup>
            </convertcart_sync_cc_setup>
        </resources>
        <helpers>
            <convertcart_analytics_cc>
                <class>Convertcart_Helper_Analytics</class>
            </convertcart_analytics_cc>
            <convertcart_sync_cc>
                <class>Convertcart_Helper_Sync</class>
            </convertcart_sync_cc>
        </helpers>
    </global>
    <default>
        <convertcart>
            <configuration>
                <enabled>1</enabled>
                <debug>0</debug>
                <enable_logging>0</enable_logging>
                <domainid></domainid>
                <api_key></api_key>
            </configuration>
            <sync>
                <enabled>1</enabled>
                <catalog>1</catalog>
                <order>1</order>
                <customer>1</customer>
                <category>1</category>
            </sync>
        </convertcart>
    </default>
    
    <adminhtml>
        <menu>
            <convertcart module="convertcart">
                <title>ConvertCart</title>
                <sort_order>100</sort_order>
                <children>
                    <config translate="title" module="convertcart">
                        <title>Configuration</title>
                        <sort_order>10</sort_order>
                        <action>adminhtml/system_config/edit/section/convertcart</action>
                    </config>
                </children>
            </convertcart>
        </menu>
        
        <events>
            <controller_action_predispatch_adminhtml_system_config_edit>
                <observers>
                    <convertcart_setup>
                        <class>convertcart/observer</class>
                        <method>checkSetup</method>
                    </convertcart_setup>
                </observers>
            </controller_action_predispatch_adminhtml_system_config_edit>
            
            <adminhtml_block_html_before>
                <observers>
                    <convertcart_add_massaction>
                        <class>convertcart/observer</class>
                        <method>addMassaction</method>
                    </convertcart_add_massaction>
                </observers>
            </adminhtml_block_html_before>
            
            <catalog_product_delete_before>
                <observers>
                    <convertcart_sync_cc_product_delete>
                        <type>singleton</type>
                        <class>Convertcart_Model_Sync_Observer</class>
                        <method>productDeleted</method>
                    </convertcart_sync_cc_product_delete>
                </observers>
            </catalog_product_delete_before>
            <catalog_category_delete_before>
                <observers>
                    <convertcart_sync_cc_category_delete>
                        <type>singleton</type>
                        <class>Convertcart_Model_Sync_Observer</class>
                        <method>categoryDeleted</method>
                    </convertcart_sync_cc_category_delete>
                </observers>
            </catalog_category_delete_before>
        </events>
        
        <acl>
            <resources>
                <admin>
                    <children>
                        <system>
                            <children>
                                <config>
                                    <children>
                                        <convertcart>
                                            <title>ConvertCart Configuration</title>
                                            <sort_order>100</sort_order>
                                        </convertcart>
                                    </children>
                                </config>
                            </children>
                        </system>
                    </children>
                </admin>
            </resources>
        </acl>
    </adminhtml>
    
    <!-- Cron Configuration -->
    <crontab>
        <jobs>
    
        </jobs>
    </crontab>
</config>
