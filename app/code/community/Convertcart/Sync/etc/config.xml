<config>
    <modules>
        <Convertcart_Sync>
            <version>1.1.4</version>
        </Convertcart_Sync>
    </modules>
    <frontend>
        <routers>
            <cc_sync>
                <use>standard</use>
                <args>
                    <module>Convertcart_Sync</module>
                    <frontName>convertcart</frontName>
                </args>
            </cc_sync>
        </routers>
    </frontend>
    <global>
        <models>
          <convertcart_sync>
              <class>Convertcart_Sync_Model</class>
              <resourceModel>convertcart_sync_resource</resourceModel>
          </convertcart_sync>
            <convertcart_sync_resource>
                <class>Convertcart_Sync_Model_Resource</class>
                <entities>
                    <activity>
                        <table>convertcart_sync_activity</table>
                    </activity>
                </entities>
            </convertcart_sync_resource>
        </models>
        <resources>
            <convertcart_sync_setup>
                <setup>
                    <module>Convertcart_Sync</module>
                </setup>
            </convertcart_sync_setup>
        </resources>
        <helpers>
          <convertcart_sync>
              <class>Convertcart_Sync_Helper</class>
          </convertcart_sync>
        </helpers>
    </global>
    <default>
        <convertcart>
            <config>
                <catalog>1</catalog>
            </config>
        </convertcart>
        <convertcart>
            <config>
                <order>1</order>
            </config>
        </convertcart>
        <convertcart>
            <config>
                <customer>1</customer>
            </config>
        </convertcart>
        <convertcart>
            <config>
                <reset_api_key>0</reset_api_key>
            </config>
        </convertcart>
    </default>
    <adminhtml>
        <events>
            <controller_action_predispatch>
                <observers>
                    <convertcart_sync_enabled>
                        <type>singleton</type>
                        <class>Convertcart_Sync_Model_Observer</class>
                        <method>generateKey</method>
                    </convertcart_sync_enabled>
                </observers>
            </controller_action_predispatch>

            <catalog_product_delete_before>
                <observers>
                    <convertcart_sync_product_delete>
                        <type>singleton</type>
                        <class>Convertcart_Sync_Model_Observer</class>
                        <method>productDeleted</method>
                    </convertcart_sync_product_delete>
                </observers>
            </catalog_product_delete_before>

            <catalog_category_delete_before>
                <observers>
                    <convertcart_sync_category_delete>
                        <type>singleton</type>
                        <class>Convertcart_Sync_Model_Observer</class>
                        <method>categoryDeleted</method>
                    </convertcart_sync_category_delete>
                </observers>
            </catalog_category_delete_before>
        </events>
        <acl>
            <resources>
                <admin>
                    <children>
                        <system>
                            <children>
                                <config>
                                    <children>
                                        <convertcart>
                                            <title>Convert Cart</title>
                                        </convertcart>
                                    </children>
                                </config>
                            </children>
                        </system>
                    </children>
                </admin>
            </resources>
        </acl>
    </adminhtml>
</config>